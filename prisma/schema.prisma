// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum InvestmentStatus {
  ACTIVE
  COMPLETED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                   String          @id @default(uuid(7)) @db.Uuid
  name                 String?
  email                String          @unique
  password             String
  phone                String?
  referralCode         String          @unique
  sponsorId            String?         @db.Uuid
  sponsor              User?           @relation("Sponsor", fields: [sponsorId], references: [id])
  referrals            User[]          @relation("Sponsor")
  mainWallet           Decimal         @default(0.0) @db.Decimal(18, 4)
  roiWallet            Decimal         @default(0.0) @db.Decimal(18, 4)
  levelWallet          Decimal         @default(0.0) @db.Decimal(18, 4)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  referralBonuses      ReferralBonus[]
  levelIncomesReceived LevelIncome[]   @relation("Receiver")
  levelIncomesGiven    LevelIncome[]   @relation("ReceivedFrom")
  rois                 Roi[]
  rankRewards          RankReward[]
  investments          Investment[]
  withdrawals          Withdrawal[]

  @@index([sponsorId])
}

model ReferralBonus {
  id        String   @id @default(uuid(7)) @db.Uuid
  amount    Decimal  @db.Decimal(18, 4)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model LevelIncome {
  id               String   @id @default(uuid(7)) @db.Uuid
  userId           String   @db.Uuid
  receivedFromId   String   @db.Uuid
  receiverUser     User     @relation("Receiver", fields: [userId], references: [id])
  receivedFromUser User     @relation("ReceivedFrom", fields: [receivedFromId], references: [id])
  roiId            String   @db.Uuid
  roi              Roi      @relation(fields: [roiId], references: [id])
  level            Int
  amount           Decimal  @db.Decimal(18, 4)
  baseAmount       Decimal  @db.Decimal(18, 4)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([roiId, level])
  @@index([userId])
  @@index([receivedFromId])
}

model Roi {
  id              String        @id @default(uuid(7)) @db.Uuid
  userId          String        @db.Uuid
  user            User          @relation(fields: [userId], references: [id])
  investmentId    String        @db.Uuid
  investment      Investment    @relation(fields: [investmentId], references: [id])
  day             Int
  baseAmount      Decimal       @db.Decimal(18, 4)
  amount          Decimal       @db.Decimal(18, 4)
  levelIncomeDone Boolean       @default(false)
  levelIncomes    LevelIncome[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([investmentId, day])
  @@index([userId])
  @@index([levelIncomeDone])
}

model RankReward {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  rank      Int
  amount    Decimal  @db.Decimal(18, 4)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Investment {
  id              String           @id @default(uuid(7)) @db.Uuid
  userId          String           @db.Uuid
  user            User             @relation(fields: [userId], references: [id])
  amount          Decimal          @db.Decimal(18, 4)
  dailyRoiPercent Decimal          @default(1) @db.Decimal(5, 2)
  totalDays       Int              @default(180)
  daysPaid        Int              @default(0)
  status          InvestmentStatus @default(ACTIVE)
  lastRoiAt       DateTime?
  rois            Roi[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([userId])
  @@index([status, lastRoiAt])
}

model Withdrawal {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @db.Uuid
  user      User             @relation(fields: [userId], references: [id])
  amount    Decimal          @db.Decimal(18, 4)
  status    WithdrawalStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId])
}
